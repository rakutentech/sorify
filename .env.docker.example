APP_NAME=Sorify
APP_ENV=local
# Generate once with:
#   docker compose run --rm --no-deps app php artisan key:generate --show
# then paste the printed value here.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000/sorify
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sorify
DB_USERNAME=sorify
DB_PASSWORD=changeme-app-password
MYSQL_ROOT_PASSWORD=changeme-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SORIFY_SCREENSHOT_RETENTION_DAYS=90
SORIFY_MAX_TEST_TIMEOUT_MS=30000
SORIFY_TEST_CODE_VERSION_RETENTION=10

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Host port the app service is published on (docker-compose.yml maps this to 8000 in-container)
APP_PORT=8000

# ── Ephemeral test execution mode ────────────────────────────────────────────
# The execution mode itself is switched in the admin System page (stored in
# the DB, defaults to "local"). These vars point the app at the runner Docker
# daemon set up by bin/setup-ephemeral-runner.
# Leave SORIFY_EXECUTION_DOCKER_HOST empty to use the default docker socket
# (Docker Desktop / dev machines) — the admin UI warns about main-daemon use.
SORIFY_EXECUTION_DOCKER_HOST=
# Host path the Docker daemon sees for storage/app/tmp — REQUIRED when the
# app runs in a container and the daemon is outside it (set to /srv/sorify/runs
# after running bin/setup-ephemeral-runner).
SORIFY_EXECUTION_HOST_RUNS_DIR=
SORIFY_EXECUTION_RUNNER_IMAGE=sorify-runner:latest
SORIFY_EXECUTION_RUNNER_NETWORK=sorify-runners

# ── Local-mode safety net (defense in depth, not a hard boundary) ───────────
# Drops the local node test process to an unprivileged user with kernel-
# enforced resource caps. Set automatically by docker-compose (uid 2000 =
# sorify-test user in the app image). Leave empty on macOS/Windows dev.
SORIFY_LOCAL_TEST_UID=
SORIFY_LOCAL_MAX_PROCESSES=256
SORIFY_LOCAL_MAX_FILESIZE=1073741824
