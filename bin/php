#!/usr/bin/env bash
## For FrankenPHP: see this https://frankenphp.dev/docs/known-issues/#composer-scripts-referencing-php
args=("$@")
index=0
for i in "$@"
do
    if [ "$i" == "-d" ]; then
        unset 'args[$index]'
        unset 'args[$index+1]'
    fi
    index=$((index+1))
done

$HOME/.local/bin/frankenphp php-cli ${args[@]}
